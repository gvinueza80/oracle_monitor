# Environment Configuration
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=debug

# API Settings
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration
DATABASE_URL=postgresql://oracle_monitor:dev_password@localhost:5432/oracle_monitor
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_CACHE_TTL=30

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379
CELERY_RESULT_BACKEND=redis://localhost:6379

# Oracle Instances (JSON format)
# Example: [{"name":"prod","user":"monitor","password":"xxx","dsn":"prod.local:1521/PROD"}]
ORACLE_INSTANCES=[]

# Metric Collection Intervals (seconds)
METRIC_COLLECTION_INTERVAL_CRITICAL=10
METRIC_COLLECTION_INTERVAL_STANDARD=30
METRIC_COLLECTION_INTERVAL_HISTORICAL=300

# Alert Configuration
ALERT_RETENTION_DAYS=365
ALERT_SUPPRESSION_DEFAULT_MINUTES=60
ALERT_ESCALATION_ENABLED=true

# Email/SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_ADDRESS=oracle-monitor@company.com

# Slack Integration
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_ALERT_CHANNEL=#database-alerts

# Vault Configuration
VAULT_ENABLED=false
VAULT_ADDR=https://vault.company.com
VAULT_TOKEN=your-vault-token

# Data Retention (days)
METRICS_RETENTION_DAYS=90
LOGS_RETENTION_DAYS=365
AUDIT_RETENTION_DAYS=730

# Performance Settings
MAX_QUERY_RESULT_SIZE=10000
SLOW_QUERY_THRESHOLD_MS=5000
